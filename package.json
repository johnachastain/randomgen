{
  "name": "randomgen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "detect-tiles": "npx tsx scripts/detectHexTiles.ts",
    "generate-tiles": "npx tsx scripts/generateHexTileRotations.ts",
    "recolor-tiles": "npx tsx scripts/recolorHexTiles.ts",
    "normalize-source-tiles": "npx tsx scripts/normalizeSourceTiles.ts",
    "generate-solid-tiles": "npx tsx scripts/generateSolidHexTiles.ts",
    "generate-transitions-config": "npx tsx scripts/generateHexTransitionsConfig.ts",
    "generate-dungeon-tiles": "npx tsx scripts/generateDungeonTiles.ts",
    "build-dungeon-atlas": "npx tsx scripts/buildDungeonTileAtlas.ts"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "indefinite": "^2.5.1",
    "jotai": "^2.18.1",
    "jotai-family": "^1.0.1",
    "radash": "^12.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.1.0",
    "react-jss": "^10.10.0",
    "recoil": "^0.7.7",
    "wouter": "^3.1.2"
  },
  "devDependencies": {
    "@types/indefinite": "^2.3.4",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vitest": "^1.6.1"
  }
}
